{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-otp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  },
  "vars": {
    "OTP_EMAIL_FROM": "Store"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OTP_DO",
        "class_name": "OtpDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OtpDurableObject"]
    }
  ]
}