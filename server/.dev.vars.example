# Copy this file to `.dev.vars` and fill in your EmailJS credentials,
# the OTP HMAC secret, and optionally a Turnstile secret.
# `.dev.vars` is used by `wrangler dev` for local development and must NOT be committed.

# EmailJS (server-to-server) credentials
EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=YOUR_PRIVATE_KEY

# OTP HMAC key (hash stored OTPs + sign the verification proof).
# Generate with:  openssl rand -hex 32
# Must match the value your trusted backend uses to verify proofs.
OTP_SECRET=YOUR_OTP_HMAC_SECRET

# Optional Turnstile secret key. If both this secret and a request token are
# present, the token is verified as an additional security layer.
# LOCAL DEV: use the test secret 1x0000000000000000000000000000000AA and the
# test token XXXX.DUMMY.TOKEN.XXXX in /send-otp.
# PRODUCTION: use a real Turnstile secret via `wrangler secret put`.
#TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# CORS permits all origins. Device fingerprint, IP, and email throttles protect
# the public OTP endpoint.
